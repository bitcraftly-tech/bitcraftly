ENVIRONMENT=development
# Local development (SQLite)
SQLITE_URL=sqlite:///./bitcraftly.db

# Production/preview database (PostgreSQL)
# Example: postgresql+psycopg://user:password@host:5432/bitcraftly
DATABASE_URL=

# Security
AUTH_SECRET=replace-with-a-random-long-secret
ACCESS_TOKEN_EXPIRE_SECONDS=86400

# Networking
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bitcraftly.com,https://www.bitcraftly.com
CORS_ORIGIN_REGEX=^https:\/\/([a-z0-9-]+\.)*bitcraftly\.com$
PUBLIC_BASE_URL=https://bitcraftly.com

# Razorpay — use Test Mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Webhooks signing secret (Dashboard → Webhooks). Falls back to RAZORPAY_KEY_SECRET if unset.
RAZORPAY_WEBHOOK_SECRET=

