# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
.turbo
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# Design Assets (Lovable)
# -----------------------------------------------------------------------------

# Ignore exported Lovable ZIP archives
docs/design/approved/**/lovable/*.zip

# Ignore temporary design exports
docs/design/temp/

# Ignore backup design files
*.fig.bak
*.sketch.bak
/src/generated/prisma
