# Browser → FastAPI. Local dev must match where uvicorn runs (see backend README).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_API_BASE_URL=https://api.bitcraftly.com
NEXT_PUBLIC_PUBLIC_BASE_URL=https://bitcraftly.com
# Staging (Vercel Preview / development branch): NEXT_PUBLIC_APP_ENV=staging
# NEXT_PUBLIC_SITE_URL=https://staging.bitcraftly.com
# NEXTAUTH_URL=https://staging.bitcraftly.com

# Founder LinkedIn (footer, process, team). Defaults to siteContent if unset.
# NEXT_PUBLIC_FOUNDER_LINKEDIN_URL=https://linkedin.com/in/sanjay-ui-frontend-developer

# Bitcraftly social profiles (footer + SEO). Defaults in lib/socialLinks.ts if unset.
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/bitcraftly
# NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61590718501473
# NEXT_PUBLIC_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@bitcraftly

# Homepage 60-sec founder intro (YouTube). Video ID or full URL — unset shows "coming soon" card.
# NEXT_PUBLIC_FOUNDER_INTRO_YOUTUBE_ID=dQw4w9WgXcQ
# NEXT_PUBLIC_FOUNDER_INTRO_YOUTUBE_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID

# Calendly embed on /contact (inline booking widget)
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/15min

# Google Analytics 4 — production only (disabled on staging). Create at analytics.google.com
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Set true in .env.local to test events in dev (optional)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# Google Search Console — HTML tag verification content (not the full meta tag)
# search.google.com/search-console → Add property → HTML tag → copy content= value only
# NEXT_PUBLIC_GSC_VERIFICATION=your-verification-token

# Optional: copy to `.env.production.local` (gitignored) then run `npm run configure:production`
# with VERCEL_TOKEN set — syncs auth, Calendly, GA4, Firebase, GSC to Vercel Production.
# See scripts/configure-vercel-env.mjs

# --- Analytics dashboard (server-side GA4 + GSC + Firestore) ---
# GA4 property ID (numeric, Admin → Property settings — NOT the G- measurement ID)
# GA4_PROPERTY_ID=123456789
# Google Cloud service account JSON (single line). Needs Analytics Data API + Search Console API access
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Search Console property URL (must match verified property exactly)
# GSC_SITE_URL=https://bitcraftly.com/
# Firebase Admin (Firestore leads + event log)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# PageSpeed Insights (Core Web Vitals panel)
# PAGESPEED_API_KEY=your-google-api-key
# Lead notifications
# ANALYTICS_LEAD_NOTIFY_EMAIL=hello@bitcraftly.com
# RESEND_API_KEY=re_xxxxxxxx (optional — email alerts on new leads)
# ANALYTICS_LEAD_NOTIFY_WHATSAPP_WEBHOOK=https://hooks.zapier.com/... (optional)

# Backend: base URL used in QR redirect links (wa.me still uses stored phone)
PUBLIC_BASE_URL=https://bitcraftly.com

# NextAuth (Google login). Vercel samples often use NEXTAUTH_SECRET instead (either works).
AUTH_SECRET=replace-with-a-random-long-secret
# NEXTAUTH_SECRET=replace-with-a-random-long-secret
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret
# Local dev (localhost). On Vercel Production use: NEXTAUTH_URL=https://bitcraftly.com
NEXTAUTH_URL=http://localhost:3000

# API base URL used by email/password auth
AUTH_API_BASE_URL=http://localhost:8000

# ShopKart showcase — Razorpay test checkout (optional; mock UI if unset)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# Same random secret on FastAPI (AUTH_GOOGLE_SYNC_SECRET) so Google OAuth can sync users + JWT after login.
AUTH_GOOGLE_SYNC_SECRET=replace-with-a-long-random-secret-shared-with-backend

# Comma-separated emails that always receive admin role (fallback when API sync is down).
AUTH_ADMIN_EMAILS=sanjayndls09@gmail.com

# Local fallback test credentials (disabled automatically in production)
AUTH_TEST_EMAIL=test.user@bitcraftly.local
AUTH_TEST_PASSWORD=Test@12345

# NextAuth JWT/session cookie lifetime (seconds). Default 30 days. Shorter values help test expiry warning locally.
# SESSION_MAX_AGE_SECONDS=86400

# Client: show expiry warning when session expires within this many ms (token expiry only — not idle).
# Falls back to NEXT_PUBLIC_SESSION_WARNING_MS if unset. Default 60000.
# NEXT_PUBLIC_SESSION_EXPIRY_WARNING_MS=60000

# Legacy alias (still supported):
# NEXT_PUBLIC_SESSION_WARNING_MS=60000

# Dayal Builders showcase — AI chat (OpenAI-compatible; OpenRouter supported)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Or OpenRouter:
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# Dayal-specific overrides (optional):
# DAYAL_CHAT_API_KEY=
# DAYAL_CHAT_BASE_URL=
# DAYAL_CHAT_MODEL=
# DAYAL_CHAT_WEBHOOK_URL=
