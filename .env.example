# =============================================================================
# Bitcraftly Platform — Environment Variables
# =============================================================================
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Production values are configured in your hosting provider (e.g. Vercel, Neon).
# See docs/engineering/production-deployment.md for the full deploy workflow.
# =============================================================================

# --- Database (Prisma + PostgreSQL / Neon) -----------------------------------
# Runtime connection (pooled URL recommended for serverless).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct connection for Prisma CLI (migrations, db:deploy). Required for Neon.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional: shadow database for `npm run db:migrate` (local dev only).
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST/shadow?sslmode=require"

# --- Lead capture (Resend) ---------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
LEAD_NOTIFICATION_TO="leads@yourcompany.com"
LEAD_FROM_EMAIL="Bitcraftly <notifications@yourdomain.com>"

# --- Owner CRM (session auth) ------------------------------------------------
OWNER_AUTH_EMAIL="owner@yourcompany.com"
OWNER_AUTH_PASSWORD="change-me-min-12-chars"
OWNER_SESSION_SECRET="generate-a-random-secret-at-least-32-characters-long"

# --- Public site URL ---------------------------------------------------------
# Canonical production URL — no trailing slash.
NEXT_PUBLIC_SITE_URL="https://bitcraftly.com"

# Bitcraftly AI Studio app (separate deploy). Used by /ai-studio CTAs + launch toast.
# Defaults to https://studio.bitcraftly.com when unset.
# NEXT_PUBLIC_AI_STUDIO_URL="https://studio.bitcraftly.com"

# --- AI Assistant (/assistant) ----------------------------------------------
# Optional. When set, /api/assistant/chat streams from OpenAI.
# When unset, the same route serves scripted demo replies.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# --- Optional ----------------------------------------------------------------
# LEAD_RATE_LIMIT_MAX=5
# LEAD_RATE_LIMIT_IP_MAX=30
# LEAD_RATE_LIMIT_WINDOW_MS=900000
# OWNER_LOGIN_RATE_LIMIT_MAX=10
# OWNER_LOGIN_RATE_LIMIT_WINDOW_MS=900000
# OWNER_LOGIN_ACCOUNT_RATE_LIMIT_MAX=5
# OWNER_LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-link"
# NEXT_PUBLIC_APP_URL="https://bitcraftly.com"
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# BUILD_ID="local"

# --- Emergency bypass (do NOT use in production) -----------------------------
# SKIP_ENV_VALIDATION=true
