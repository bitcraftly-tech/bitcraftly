# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Pooled connection for application runtime (note the -pooler hostname suffix).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection for Prisma CLI (migrations, db push, introspection).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Lead capture — Resend notification (server-only)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxx
LEAD_NOTIFICATION_TO=your-team@company.com
LEAD_FROM_EMAIL=Bitcraftly Leads <notifications@verified-domain.com>

# -----------------------------------------------------------------------------
# Owner CRM authentication (server-only)
# -----------------------------------------------------------------------------
OWNER_AUTH_EMAIL=owner@company.com
OWNER_AUTH_PASSWORD=replace-with-a-strong-password
OWNER_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
